NON_OVERLAP_STEP = 5


def calc_non_overlapping_pfmc(daily_5d_ret, period=NON_OVERLAP_STEP):
    """对“重叠的 5 日绝对收益”序列做非重叠采样评估。
    输入：原始 5 日绝对收益（ret-1，未 /5）。
    内部构造 period 条互不重叠的相位路径（offset::period）并取平均：
    年化系数 252/period；有效独立样本≈总交易日/period，Sharpe 置信区间较宽，别过度解读。
    """
    r0 = pd.Series(daily_5d_ret).dropna().sort_index()   # 先去掉缺失再按交易日位置切，避免 NaN 造成相位错位
    acc = {'return': [], 'sharpe': [], 'std': [], 'winratio': [], 'mdd': [], 'n_periods': []}
    ann = 252.0 / period
    for offset in range(period):
        sampled = r0.iloc[offset::period]
        if len(sampled) < 2:
            continue
        nav = (1.0 + sampled).cumprod()                  # 复利净值，最大回撤更准
        dd = nav / nav.cummax() - 1.0
        sd = sampled.std()
        acc['return'].append(float(sampled.mean() * ann))
        acc['sharpe'].append(float(sampled.mean() / sd * (ann ** 0.5)) if sd > 0 else np.nan)
        acc['std'].append(float(sd))
        acc['winratio'].append(float((sampled > 0).mean()))
        acc['mdd'].append(float(dd.min()))
        acc['n_periods'].append(int(len(sampled)))
    return {k: (float(np.nanmean(v)) if np.any(np.isfinite(np.asarray(v, dtype=float))) else np.nan)
            for k, v in acc.items()}


