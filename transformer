def max_dd_group(returns):
    """Assumes returns is a pandas Series"""
    r = returns.cumsum() + 1
    dd = r.div(r.cummax()).sub(1)
    mdd = dd.min()
    end = returns.index[dd.argmin()]
    start = returns.index[r.loc[:end].argmax()]
    return mdd, start, end


