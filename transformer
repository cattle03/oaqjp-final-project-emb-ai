price_PD_total['open_up_t1'] = (price_PD_total.groupby('ts_code').open.shift(-1)
                                / price_PD_total.groupby('ts_code').close.shift(0))


def _limit_ratio(code):
    """按板块推断涨跌停幅度（不含 ST）。"""
    if code.startswith(('688', '689')):      # 科创板
        return 0.20
    if code.startswith(('300', '301')):      # 创业板（注册制）
        return 0.20
    if code.startswith(('8', '4', '920')):   # 北交所
        return 0.30
    return 0.10                              # 主板


price_PD_total['limit_pct'] = price_PD_total['ts_code'].map(_limit_ratio)
# 买入日开盘未触及涨跌停（留 0.5% 缓冲）才视为可成交；与 NaN 比较自然得到 False
price_PD_total['buy_tradable'] = (
    (price_PD_total['open_up_t1'] < 1 + price_PD_total['limit_pct'] - 0.005)
    & (price_PD_total['open_up_t1'] > 1 - price_PD_total['limit_pct'] + 0.005)
).astype(bool)

# t收盘买 t+1收盘卖
