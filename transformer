# 3) 带隔离带（Purge/Embargo）的扩展窗口切分
#    输入窗口 SEQ_LEN 天 + 标签跨度 5 天 => 至少 25 个交易日的隔离带，切断训练/验证交界泄露
PURGE_GAP_DAYS = SEQ_LEN + 5
uniq_dates = np.sort(np.unique(sample_dates))
n_dates = len(uniq_dates)

folds = []
edges = np.linspace(0, n_dates, N_SPLITS + 2).astype(int)
for k in range(N_SPLITS):
    val_lo, val_hi = edges[k + 1], edges[k + 2]
    if val_hi <= val_lo:
        continue
    purge_end = val_lo - PURGE_GAP_DAYS           # 训练集只能用到隔离带之前
    if purge_end <= 0:
        continue
    train_last_date = uniq_dates[purge_end - 1]
    val_first_date = uniq_dates[val_lo]
    val_last_date = uniq_dates[val_hi - 1]
    trn_idx = np.where(sample_dates <= train_last_date)[0]
    val_idx = np.where((sample_dates >= val_first_date) & (sample_dates <= val_last_date))[0]
    if len(trn_idx) < BATCH_SIZE or len(val_idx) == 0:
        continue
    folds.append((trn_idx, val_idx))

if not folds:
    raise RuntimeError('可用训练数据不足，无法构造带隔离带的 walk-forward 折，请检查 SPLIT_DATE / 数据长度')
print(f'purged walk-forward folds: {len(folds)} (gap={PURGE_GAP_DAYS} trading days)')


def _mean_rank_ic(pred, dates, act):
    """逐日截面 Rank IC 的均值（Spearman），用于按“排序能力”挑模型。"""
    df = pd.DataFrame({'d': dates, 'p': pred, 'a': act}).dropna()
    if len(df) == 0:
        return float('nan')
