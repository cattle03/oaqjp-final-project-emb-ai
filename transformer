def screen_factor_quality(data, features, ret_col='ret5', thresholds=None,
                          top_k=8, min_winratio=0.50, max_mdd=-0.95, min_abs_icir=0.05):
    """
    在训练期数据上对每个因子做质量诊断，并按 |ICIR| 选出 top-K。

    选择逻辑（与回测口径一致，且不依赖会被污染的 sharpe/mdd 门槛）：
      1) 硬性排除：多空胜率 < min_winratio 或 多空最大回撤 < max_mdd 的因子直接淘汰；
      2) 其余按 |ICIR| 从高到低排序，取前 top_k 个。
    passed（是否过 DEFAULT 门槛）只作报告信息，不参与最终选择。

    返回
    ----
    report : DataFrame   每个因子一行的诊断结果（含 eligible / passed / 关键指标）
    selected : list      入选因子名（保持原始顺序）
    """
    horizon = _EVAL_HORIZON.get(ret_col, 1)
    screen = data[data['trade_date'] < SPLIT_DATE]
    rows = []
    for feat in tqdm(features, desc='factor quality screen'):
        alpha = pd.DataFrame({
            'ts_code': screen['ts_code'].values,
            'trade_date': screen['trade_date'].values,
            'industry': _DATA_INDUSTRY,
            'factor': pd.to_numeric(screen[feat], errors='coerce').replace([np.inf, -np.inf], np.nan).values,
            'ret1': pd.to_numeric(screen[ret_col], errors='coerce').replace([np.inf, -np.inf], np.nan).values,
        })
        try:
            res = evaluate_alpha(alpha, horizon=horizon)
            summary = res['summary']
            passed, _ = pass_quality_gate(summary, thresholds=thresholds)
            rows.append({
                'feature': feat,
                'diff_sharpe': summary['diff_sharpe'],
                'diff_return': summary['diff_return'],
                'diff_winratio': summary['diff_winratio'],
                'diff_mdd': summary['diff_mdd'],
                'ic_mean': summary['ic_mean'],
                'ic_std': summary['ic_std'],
                'icir': summary['icir'],
                'monotonic': summary['monotonic'],
                'passed': bool(passed),
                'error': '',
            })
        except Exception as e:
            # 某些因子（全 NaN / 常量 / 分档缺失）无法诊断，记为未通过并记录原因
            rows.append({
                'feature': feat, 'diff_sharpe': np.nan, 'diff_return': np.nan,
                'diff_winratio': np.nan, 'diff_mdd': np.nan, 'ic_mean': np.nan,
                'ic_std': np.nan, 'icir': np.nan, 'monotonic': False, 'passed': False,
                'error': str(e),
            })
    report = pd.DataFrame(rows)
    report['abs_icir'] = report['icir'].abs()

    # 1) 硬性排除：胜率过低 / 回撤接近清零 / |ICIR| 过小（纯噪声）的因子直接淘汰
    hard_ok = ((report['diff_winratio'] >= min_winratio)
               & (report['diff_mdd'] >= max_mdd)
               & (report['abs_icir'] >= min_abs_icir))
    report['eligible'] = hard_ok

    # 2) 合格因子按 |ICIR| 取 top-K
    eligible = report.loc[hard_ok].sort_values('abs_icir', ascending=False, na_position='last')
    selected_feats = eligible['feature'].head(top_k).tolist()

    # 安全兜底：若硬性排除后不足 2 个，退回全体按 |ICIR| 取 top-K，保证仍能训练
    if len(selected_feats) < 2:
        print('[warn] 硬性排除后候选因子不足 2 个，回退为全体按 |ICIR| 取 top-K')
        selected_feats = (report.sort_values('abs_icir', ascending=False, na_position='last')
                          ['feature'].head(top_k).tolist())

    selected_set = set(selected_feats)
    selected = [f for f in features if f in selected_set]   # 保持原始因子顺序
    return report, selected


